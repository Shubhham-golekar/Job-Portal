# Copy to .env.local and fill in real values
# NEVER commit .env.local to git

# Midnight network target (dev | preview)
MIDNIGHT_SEED=

# Root deploy / CLI
MIDNIGHT_NETWORK=preview

# Frontend env vars (also copy into frontend/.env.local)
VITE_NETWORK=preview
VITE_CONTRACT_ADDRESS=
VITE_INDEXER_URL=https://indexer.preview.midnight.network
VITE_PROOF_SERVER_URL=https://proof-server.preview.midnight.network
